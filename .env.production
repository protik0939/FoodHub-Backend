# Production Environment Variables
# Make sure to set these in your Vercel Dashboard under Environment Variables

# Database
DATABASE_URL=your_production_database_url_here

# Email Configuration
APP_USER=your_email_here
APP_PASS=your_app_password_here

# Google OAuth
GOOGLE_CLIENT_ID=your_google_client_id_here
GOOGLE_CLIENT_SECRET=your_google_client_secret_here

# CRITICAL: Backend URL - Must be your Vercel backend URL
BETTER_AUTH_URL=https://food-hub-backend-teal.vercel.app

# Frontend URLs
APP_URL=https://bdfoodhub.vercel.app
PROD_APP_URL=https://bdfoodhub.vercel.app

# Node Environment
NODE_ENV=production
