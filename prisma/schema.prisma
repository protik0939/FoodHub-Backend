// This is your Prisma schema file,
// learn more about it in the docs: https://pris.ly/d/prisma-schema

// Looking for ways to speed up your queries, or scale easily with your serverless or edge functions?
// Try Prisma Accelerate: https://pris.ly/cli/accelerate-init

generator client {
  provider = "prisma-client"
  output   = "../generated/prisma"
}

datasource db {
  provider = "postgresql"
}

model User {
  id            String    @id
  name          String
  email         String
  emailVerified Boolean   @default(false)
  image         String?
  createdAt     DateTime  @default(now())
  updatedAt     DateTime  @updatedAt
  sessions      Session[]
  accounts      Account[]

  role            String           @default("CUSTOMER")
  accountStatus   String           @default("ACTIVE")
  userProfile     UserProfile?
  providerProfile ProviderProfile?
  adminProfile    AdminProfile?
  orders          Order[]

  @@unique([email])
  @@map("user")
}

model Session {
  id        String   @id
  expiresAt DateTime
  token     String
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  ipAddress String?
  userAgent String?
  userId    String
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([token])
  @@index([userId])
  @@map("session")
}

model Account {
  id                    String    @id
  accountId             String
  providerId            String
  userId                String
  user                  User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  accessToken           String?
  refreshToken          String?
  idToken               String?
  accessTokenExpiresAt  DateTime?
  refreshTokenExpiresAt DateTime?
  scope                 String?
  password              String?
  createdAt             DateTime  @default(now())
  updatedAt             DateTime  @updatedAt

  @@index([userId])
  @@map("account")
}

model Verification {
  id         String   @id
  identifier String
  value      String
  expiresAt  DateTime
  createdAt  DateTime @default(now())
  updatedAt  DateTime @updatedAt

  @@index([identifier])
  @@map("verification")
}

model UserProfile {
  id          String    @id @default(uuid())
  firstName   String    @db.VarChar(255)
  lastName    String    @db.VarChar(255)
  dateOfBirth DateTime?
  address     String?   @db.Text
  contactNo   String?   @db.VarChar(50)

  userId String @unique
  user   User   @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@map("userProfile")
}

model ProviderProfile {
  id              String @id @default(uuid())
  providerName    String @db.VarChar(255)
  providerEmail   String @db.VarChar(255)
  providerContact String @db.VarChar(50)
  providerAddress String @db.Text

  ownerName  String @db.VarChar(255)
  ownerEmail String @db.VarChar(255)

  userId String @unique
  user   User   @relation(fields: [userId], references: [id], onDelete: Cascade)

  meals Meal[]

  @@map("providerProfile")
}

model AdminProfile {
  id      String @id @default(uuid())
  name    String @db.VarChar(255)
  contact String @db.VarChar(50)

  userId String @unique
  user   User   @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@map("adminProfile")
}

model Category {
  id          String  @id @default(uuid())
  name        String  @db.VarChar(255)
  description String? @db.Text

  meals Meal[]

  @@map("categories")
}

model Meal {
  id          String   @id @default(uuid())
  name        String   @db.VarChar(255)
  description String   @db.Text
  price       Float
  quantity    String   @db.VarChar(255)
  imageUrl    String   @db.VarChar(255)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  categoryId String
  providerId String

  category Category        @relation(fields: [categoryId], references: [id])
  provider ProviderProfile @relation(fields: [providerId], references: [id])

  orders Order[]

  @@map("meals")
}

model Order {
  id     String      @id @default(uuid())
  status OrderStatus @default(PREPARING)

  userId String
  user   User   @relation(fields: [userId], references: [id], onDelete: Cascade)

  mealId String

  meal    Meal     @relation(fields: [mealId], references: [id])
  reviews Review[]

  @@map("orders")
}

model Review {
  id          String   @id @default(uuid())
  reviewPoint Float
  comment     String?  @db.Text
  imageUrl    String?  @db.VarChar(255)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  orderId String
  order   Order  @relation(fields: [orderId], references: [id], onDelete: Cascade)

  @@map("review")
}

enum OrderStatus {
  PREPARING
  READY
  DELIVERED
  CANCELLED
}

enum UserRole {
  CUSTOMER
  PROVIDER
  ADMIN
}

enum UserStatus {
  ACTIVE
  SUSPENDED
}
